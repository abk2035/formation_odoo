<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- ...model definition from before... -->
        <record id="department_list_view" model="ir.ui.view">
            <!-- <field name="model_id" ref="estate.model_real_estate_property" /> -->
            <field name="name">Department list</field>
            <field name="model">university.department</field>
            <field name="arch" type="xml">
                <tree string="Department List">
                    <field name="name"/>
                    <field name="code"/>
                </tree>
            </field>
        </record>
        <!-- definition of form -->
        <record id="department_form_view" model="ir.ui.view">
            <field name="name">Department Form</field>
            <field name="model">university.department</field>
            <field name="arch" type="xml">
                <form string="Department Form">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>    
        <!-- action opening the department form view -->
        <record id="action_department_form" model="ir.actions.act_window">
            <field name="name">Department window</field>
            <field name="res_model">university.department</field>
            <field name="view_mode">tree,form</field>
        </record>    

        <!-- top menu item -->
        <menuitem
            id="university_menu_root"
            name="University"
            sequence="1"/>

        <!-- menu item categorizing department menu item -->
        <menuitem
            id="university_department_cat"
            name="Departments"
            parent="university_menu_root"
            sequence="1"/>

        <!-- action -->
        <menuitem
            id="university_department_list"
            name="List of departments"
            parent="university_department_cat"
            action="action_department_form"
            sequence="1"/>
            
    </data>    
</odoo>