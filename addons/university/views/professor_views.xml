<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- ...model definition from before... -->
        <record id="professor_list_view" model="ir.ui.view">
            <!-- <field name="model_id" ref="estate.model_real_estate_property" /> -->
            <field name="name">professor list</field>
            <field name="model">university.professor</field>
            <field name="arch" type="xml">
                <tree string="professor List">
                                <field name="f_name"/>
                                <field name="l_name"/>
                                <field name="sexe"/>
                                <field name="identity_card"/>
                                <field name="birthday"/>                                                        
                                <field name="inscription_date"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="active"/>
                </tree>
            </field>
        </record>
        <!-- definition of form -->
        <record id="professor_form_view" model="ir.ui.view">
            <field name="name">professor Form</field>
            <field name="model">university.professor</field>
            <field name="arch" type="xml">
                <form string="Professor Form">
                    <sheet>
                         <group>
                                <field name="f_name"/>
                                <field name="l_name"/>
                                <field name="sexe"/>
                                <field name="identity_card"/>
                                <field name="birthday"/>                                                        
                                <field name="inscription_date"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="active"/>
                                <field name="department_id"/>
                                <field name="subject_id"/>
                        </group> 
                        <notebook>
                            <page  string="List f of classrooms">
                                <field name="classroom_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>    
        <!-- action opening the professor form view -->
        <record id="action_professor_form" model="ir.actions.act_window">
            <field name="name">Professor window</field>
            <field name="res_model">university.professor</field>
            <field name="view_mode">tree,form</field>
        </record>    

        <!-- top menu item -->
        <menuitem
            id="university_menu_root"
            name="University"
            sequence="1"/>

        <!-- menu item categorizing professor menu item -->
        <menuitem
            id="university_professor_cat"
            name="Professors"
            parent="university_menu_root"
            sequence="1"/>

        <!-- action -->
        <menuitem
            id="university_professor_list"
            name="List of Professors"
            parent="university_professor_cat"
            action="action_professor_form"
            sequence="1"/>
            
    </data>    
</odoo>