<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="dm_bank_transactions_form_view">
      <field name="name">dm.bank.transactions.form.view</field>
      <field name="model">dm.bank.transactions</field>
      <field name="arch" type="xml">
        <form>
            <header>
                <button name="transaction_done" type="object" string="Transaction" class="oe_highlight"
                    invisible="state == 'done'"/>
                <button name="%(deposit_management.action_report_bank_transaction_slip)d" type="action"
                    string="Print Receipt" class="oe_highlight"
                    invisible="state != 'done'"/>
                <field name="state" widget="statusbar" />
            </header>
            <sheet>
                <group>
                    <group>
                        <field name="name" readonly="state == 'done'"/>
                        <field name="bank_id" readonly="state == 'done'" />
                    </group>
                    <group>
                        <field name="remarks" readonly="state == 'done'"/>
                        <field name="balance" readonly="state == 'done'" />
                        <field name="tran_state" readonly="state == 'done'" />
                    </group>
                </group>
            </sheet>
        </form>
      </field>
    </record>

    <record model="ir.ui.view" id="dm_bank_transactions_tree_view">
      <field name="name">dm.bank.transactions.tree.view</field>
      <field name="model">dm.bank.transactions</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name" />
          <field name="bank_id" />
          <field name="final_balance" sum="Final Balance" />
          <field name="balance" sum="Total Balance"/>
          <field name="state" />
        </tree>
      </field>
    </record>

    <record model="ir.actions.act_window" id="dm_bank_transactions_windows_action">
      <field name="name">Transactions</field>
      <field name="res_model">dm.bank.transactions</field>
      <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Transactions" id="dm_bank_transactions_list" parent="dm_bank_root_menu"/>
    <menuitem name="Customer Transactions" id="dm_transaction_banks" parent="dm_bank_transactions_list"
        action="dm_bank_transactions_windows_action"/>

</odoo>